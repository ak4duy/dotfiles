workspace "web" {}
workspace "chat" {}
workspace "code" {}
workspace "work" {}
workspace "term" {
    layout {
        default-column-width { proportion 0.25; }
    }
}

window-rule {
    match app-id="brave-origin"
    open-on-workspace "web"
    open-maximized-to-edges true
}

// brave-origin extension
window-rule {
    match app-id="brave-amfojhdiedpdnlijjbhjnhokbnohfdfb-Default"
    open-on-workspace "web"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
}

window-rule {
    match app-id="Element"
    open-on-workspace "chat"
    open-maximized-to-edges true
}

window-rule {
    match app-id="vesktop"
    open-on-workspace "chat"
    open-maximized-to-edges true
}

window-rule {
    match app-id="dev.zed.Zed"
    open-on-workspace "code"
    open-maximized-to-edges true
}

window-rule {
    match app-id="^steam_app_" 
    open-on-workspace "code"
}

window-rule {
    match app-id="steam" title="^Steam$"
    open-on-workspace "term"
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id="^org.strawberrymusicplayer.strawberry$"
    open-on-workspace "term"
    default-column-width { proportion 0.5; }
    default-window-height { proportion 0.65; }
}

window-rule {
    match app-id="^zeron$"
    open-on-workspace "work"
}

window-rule {
    match app-id="eu.betterbird.Betterbird"
    open-on-workspace "term"
}

window-rule {
    match app-id="^Alacritty$"

    background-effect {
        blur true
        xray false
    }
}

gestures {
    dnd-edge-view-scroll {
        trigger-width 30
        delay-ms 100
        max-speed 1500
    }

    dnd-edge-workspace-switch {
        trigger-height 50
        delay-ms 100
        max-speed 1500
    }

    hot-corners {
        top-left
    }
}

blur {
    passes 2 
    offset 4.0
    noise 0.01     
    saturation 1.50
}
