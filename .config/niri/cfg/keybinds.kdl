binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── Noctalia v5 ───
    Mod+Q                          hotkey-overlay-title="Open Terminal: Alacritty" { spawn "alacritty"; }
    Mod+Return                     { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+R                          { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B                          hotkey-overlay-title="Open Browser: Brave" { spawn "brave-origin"; }
    Mod+ALT+L                      { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Q                    { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+V                          { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Mod+Period                     { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Mod+Shift+Return               { spawn-sh "noctalia msg panel-toggle launcher /win"; }

    // Please choose your own file manager.
    Mod+E                          hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus"; }

    // Audio
    XF86AudioRaiseVolume            allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume            allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                   allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                   allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                   allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                   allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                  allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

    // Brightness
    XF86MonBrightnessUp             allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown           allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // ─── Window Movement and Focus ───
    Mod+ESCAPE                               { close-window; }

    Mod+Left                            { focus-column-left; }
    Mod+H                               { focus-column-left; }
    Mod+Right                           { focus-column-right; }
    Mod+L                               { focus-column-right; }
    Mod+Up                              { focus-window-up; }
    Mod+J                               { focus-window-up; }
    Mod+Down                            { focus-window-down; }
    Mod+K                               { focus-window-down; }

    Mod+I       hotkey-overlay-title="Stack window below" { consume-window-into-column; }
    Mod+Shift+I hotkey-overlay-title="Unstack window" { expel-window-from-column; }

    Mod+SHIFT+Left                     { move-column-left; }
    Mod+SHIFT+H                          { move-column-left; }
    Mod+CTRL+H                          { move-column-left; }

    Mod+SHIFT+L                          { move-column-right; }
    Mod+SHIFT+Right                      { move-column-right; }
    Mod+CTRL+L                          { move-column-right; }


    Mod+SHIFT+UP                         { move-column-to-workspace-up; }
    Mod+SHIFT+J                          { move-column-to-workspace-up; }
    Mod+SHIFT+Down                       { move-column-to-workspace-down; }
    Mod+SHIFT+K                          { move-column-to-workspace-down; }

    Mod+Home                            { focus-column-first; }
    Mod+End                             { focus-column-last; }
    Mod+CTRL+Home                       { move-column-to-first; }
    Mod+CTRL+End                        { move-column-to-last; }

    // Mod+Shift+Left                      { focus-monitor-left; }
    // Mod+Shift+Right                     { focus-monitor-right; }
    // Mod+Shift+UP                        { focus-monitor-up; }
    // Mod+Shift+Down                      { focus-monitor-down; }

    Mod+Shift+CTRL+Left                 { move-column-to-monitor-left; }
    Mod+Shift+CTRL+Right                { move-column-to-monitor-right; }
    Mod+Shift+CTRL+UP                   { move-column-to-monitor-up; }
    Mod+Shift+CTRL+Down                 { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+CTRL+WheelScrollDown            cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+CTRL+WheelScrollUp              cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight                { focus-column-right; }
    Mod+WheelScrollLeft                 { focus-column-left; }
    Mod+CTRL+WheelScrollRight           { move-column-right; }
    Mod+CTRL+WheelScrollLeft            { move-column-left; }

    Mod+Shift+WheelScrollDown           { focus-column-right; }
    Mod+Shift+WheelScrollUp             { focus-column-left; }
    Mod+CTRL+Shift+WheelScrollDown      { move-column-right; }
    Mod+CTRL+Shift+WheelScrollUp        { move-column-left; }

    Mod+1      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 1"; }
    Mod+2      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 2"; }
    Mod+3      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 3"; }
    Mod+4      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 4"; }
    Mod+CTRL+1 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 5"; }
    Mod+CTRL+2 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 6"; }
    Mod+CTRL+3 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 7"; }
    Mod+CTRL+4 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 8"; }
    Mod+CTRL+5 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 9"; }
    Mod+CTRL+6 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" switch 10"; }

    Mod+SHIFT+1      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 1"; }
    Mod+SHIFT+2      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 2"; }
    Mod+SHIFT+3      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 3"; }
    Mod+SHIFT+4      { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 4"; }
    Mod+CTRL+SHIFT+1 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 5"; }
    Mod+CTRL+SHIFT+2 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 6"; }
    Mod+CTRL+SHIFT+3 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 7"; }
    Mod+CTRL+SHIFT+4 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 8"; }
    Mod+CTRL+SHIFT+5 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 9"; }
    Mod+CTRL+SHIFT+6 { spawn-sh "bash \"$HOME/.config/niri/cfg/bin/niri-workspace.sh\" move 10"; }

    ALT+TAB                             { focus-workspace-previous; }
    Mod+Shift+TAB                             { focus-monitor-next; }


    // ─── Layout Controls ───
    Mod+CTRL+F                          { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+CTRL+Left                          { set-column-width "-10%"; }
    Mod+CTRL+Right                           { set-column-width "+10%"; }
    Mod+CTRL+Up                         { set-window-height "-10%"; }
    Mod+CTRL+Down                     { set-window-height "+10%"; }

    // ─── Modes ───
    Mod+T                               { toggle-window-floating; }
    Mod+F        { maximize-window-to-edges; }
    Mod+Shift+F                               { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }

    // ─── Screenshots ───
    PRINT                               { screenshot; }
    CTRL+Shift+2                        { screenshot-screen; }
    CTRL+Shift+3                        { screenshot-window; }

    // Recording - OBS
    // ALT+F1 allow-inhibiting=false cooldown-ms=150 hotkey-overlay-title="OBS: Toggle Recording" {
    //     spawn-sh "obs-cmd recording toggle; notify-send -i media-record 'OBS' 'Recording toggled'";
    // }
    //
    // ALT+F2 allow-inhibiting=false cooldown-ms=150 hotkey-overlay-title="OBS: Save Replay Buffer" {
    //     spawn-sh "obs-cmd replay save; notify-send -i media-record 'OBS' 'Replay buffer saved'";
    // }

    // ─── Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+Shift+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; } // Also quits Niri
    Mod+Shift+P                         { power-off-monitors; } // Turn off screens (useful for OLED or privacy)
    Mod+O                               repeat=false { toggle-overview; }
}
