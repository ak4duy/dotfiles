{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/home/akaduy/.config/fastfetch/ascii/bocchi.txt",
    "type": "auto",
    "height": 15,
    "width": 30,
    "padding": {
      "top": 3,
      "left": 1,
    },
    "color": {
      "1": "38;2;243;146;167",
      "2": "38;2;98;216;252",
      "3": "38;2;254;227;63",
      "4": "38;2;134;129;122",
      "6": "38;2;61;103;155",
      "5": "38;2;180;169;162",
      "7": "38;2;102;191;212",
    },
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[32m┌──────────────────────Hardware──────────────────────┐",
    },
    {
      "type": "host",
      "key": " PC",
      "keyColor": "green",
    },
    {
      "type": "cpu",
      "key": "│ ├",
      "keyColor": "green",
    },
    {
      "type": "gpu",
      "key": "│ ├󰍛",
      "keyColor": "green",
    },
    {
      "type": "memory",
      "key": "│ ├󰍛",
      "keyColor": "green",
    },
    {
      "type": "disk",
      "key": "└ └",
      "keyColor": "green",
    },
    {
      "type": "custom",
      "format": "\u001b[32m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[33m┌──────────────────────Software──────────────────────┐",
    },
    {
      "type": "os",
      "key": " OS",
      "keyColor": "yellow",
    },
    {
      "type": "kernel",
      "key": "│ ├",
      "keyColor": "yellow",
    },
    {
      "type": "bios",
      "key": "│ ├",
      "keyColor": "yellow",
    },
    {
      "type": "packages",
      "key": "│ ├󰏖",
      "keyColor": "yellow",
    },
    {
      "type": "shell",
      "key": "└ └",
      "keyColor": "yellow",
    },
    "break",
    {
      "type": "de",
      "key": " DE",
      "keyColor": "blue",
    },
    {
      "type": "lm",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "wm",
      "key": "│ ├",
      "keyColor": "blue",
    },
    {
      "type": "wmtheme",
      "key": "│ ├󰉼",
      "keyColor": "blue",
    },
    {
      "type": "terminal",
      "key": "└ └",
      "keyColor": "blue",
    },
    {
      "type": "custom",
      "format": "\u001b[34m└────────────────────────────────────────────────────┘",
    },
    "break",
    {
      "type": "custom",
      "format": "\u001b[35m┌──────────────────Uptime / Age / DT─────────────────┐",
    },
    {
      "type": "command",
      "key": "  OS Age ",
      "keyColor": "magenta",
      "text": "day_of_week=$(date '+%A'); birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install )); days_difference=$((time_progression / 86400)); echo $days_difference days;",
    },
    {
      "type": "uptime",
      "key": "  Uptime ",
      "keyColor": "magenta",
    },
    {
      "type": "command",
      "key": "  DateTime ",
      "keyColor": "magenta",
      "text": "echo $(date '+%Y-%m-%d %H:%M:%S %A')",
    },
    {
      "type": "custom",
      "format": "\u001b[35m─────────────────────────────────────────────────────┘",
    },

    //        {
    //            "type": "colors"
    //        },

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
